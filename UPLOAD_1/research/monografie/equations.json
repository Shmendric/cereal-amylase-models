  "ht_orbits": "(v_0,a_N,a_R,\\eta,\\kappa)\\mapsto(\\lambda v_0,a_N/\\lambda,a_R/\\mu,\\mu\\eta,\\kappa/\\lambda),\\quad\\lambda,\\mu>0",
  "ht_rank": "\\det J_{(v_0,a_R,\\kappa)}=a_N\\eta e v_0>0,\\qquad\\operatorname{rank}J=3",
  "ht_eff": "\\eta_{\\mathrm{eff}}=\\rho\\eta,\\qquad Z=a_N(v_0+\\eta_{\\mathrm{eff}}e)",
  "ht_bridge": "a_N=\\frac{D}{\\rho\\ell},\\quad v_0=\\frac{\\rho\\ell N}{D},\\quad a_R=\\frac{D}{\\ell},\\quad\\kappa=\\frac{ED}{\\rho\\ell N},\\quad\\ell=\\eta e",
  "ht_kappa": "v_0=\\frac{E}{\\kappa},\\quad a_N=\\frac{N\\kappa}{E},\\quad a_R\\eta=\\frac{D}{e}",
  "ht_bias": "\\widehat a=\\frac{D}{\\ell}=a_R,\\quad\\widehat v_0=\\frac{\\ell N}{D}=\\frac{v_0}{\\rho},\\quad\\frac{\\widehat a}{a_N}=\\rho,\\quad\\widehat a\\widehat v_0=N",
  "ht_rhobounds": "\\begin{aligned}v_0&\\in\\left[\\rho_-\\frac{\\ell N}{D},\\rho_+\\frac{\\ell N}{D}\\right],\\\\a_N&\\in\\left[\\frac{D}{\\rho_+\\ell},\\frac{D}{\\rho_-\\ell}\\right].\\end{aligned}",
  "ht_budget": "\\left|\\frac{\\widehat v_0}{v_0}-1\\right|\\le\\varepsilon\\quad\\Longleftrightarrow\\quad\\frac{1}{1+\\varepsilon}\\le\\rho\\le\\frac{1}{1-\\varepsilon},\\qquad 0<\\varepsilon<1",
  "ht_minimax": "\\begin{aligned}\\rho_0^*&=\\frac{2\\rho_-\\rho_+}{\\rho_-+\\rho_+},\\quad\\widehat v_{0,*}=\\rho_0^*\\frac{\\ell N}{D},\\\\\\min_{\\rho_0>0}\\max_{\\rho\\in[\\rho_-,\\rho_+]}\\left|\\frac{\\rho_0}{\\rho}-1\\right|&=\\frac{\\rho_+-\\rho_-}{\\rho_++\\rho_-}.\\end{aligned}",
  "ht_interval": "v_0\\in[C\\rho_-\\eta_-,C\\rho_+\\eta_+]\\cap[E/\\kappa_+,E/\\kappa_-],\\qquad C=\\frac{Ne}{D}",
  "ht_hardbounds": "\\begin{aligned}\\frac{D-\\delta_D}{\\rho_+(\\ell+\\delta_\\ell)}&\\le a_{N,\\mathrm{true}}\\le\\frac{D+\\delta_D}{\\rho_-(\\ell-\\delta_\\ell)},\\\\\\frac{\\rho_-(\\ell-\\delta_\\ell)(N-\\delta_N)}{D+\\delta_D}&\\le v_{0,\\mathrm{true}}\\le\\frac{\\rho_+(\\ell+\\delta_\\ell)(N+\\delta_N)}{D-\\delta_D}.\\end{aligned}",
  "ht_dose": "Z(e)=(1+\\chi e)N+a_R\\eta e=N+(a_R\\eta+N\\chi)e,\\qquad\\chi\\ge0",
  "p2_comparison": "\\begin{gathered}P(t)=P_0+\\Delta\\left[f\\left(1-e^{-k_1t}\\right)+(1-f)\\left(1-e^{-k_2t}\\right)\\right],\\\\0\\leq f\\leq1,\\quad\\Delta\\geq0,\\quad k_1,k_2>0.\\end{gathered}",
  "inactivation_E_equivalence": "\\begin{gathered}\\dot P(t)=b e^{-dt},\\quad P(t)=P_0+\\frac{b}{d}\\left(1-e^{-dt}\\right),\\\\k=d,\\quad\\Delta=\\frac{b}{d},\\quad d>0.\\end{gathered}",
  "forecast_risk_condition": "\\begin{aligned}R_{\\mathrm{mod},j}-R_{\\mathrm{ref},j}&=B_j^2+\\tau_j^2-\\delta_j^2-\\sigma_m^2,\\\\R_{\\mathrm{mod},j}<R_{\\mathrm{ref},j}&\\ \\Longleftrightarrow\\ B_j^2+\\tau_j^2<\\delta_j^2+\\sigma_m^2.\\end{aligned}",
  "forecast_risk_covariance": "\\begin{gathered}R_{\\mathrm{mod},j}-R_{\\mathrm{ref},j}=B_j^2+\\tau_j^2-\\delta_j^2-\\sigma_m^2-2c_{\\mathrm{mod},j}+2c_{\\mathrm{ref},j},\\\\c_{\\mathrm{mod},j}=\\operatorname{Cov}(\\widehat P_j,\\varepsilon_j),\\quad c_{\\mathrm{ref},j}=\\operatorname{Cov}(\\varepsilon_m,\\varepsilon_j).\\end{gathered}"
}
