  "three_point_precision": "\\begin{aligned} A&=Y_2-Y_1,\\quad B=Y_3-Y_2,\\\\ g=\\nabla_Y d&=\\frac{1}{h}\\left(-\\frac{1}{A},\\ \\frac{1}{A}+\\frac{1}{B},\\ -\\frac{1}{B}\\right)^{\\mathsf T},\\\\ u^2(d)&\\simeq g^{\\mathsf T}\\Sigma_Yg=\\frac{2\\sigma^2}{h^2}\\left(\\frac{1}{A^2}+\\frac{1}{B^2}+\\frac{1}{AB}\\right).\\end{aligned}",
  "three_point_box": "\\begin{aligned} \\frac{1}{h}\\log\\frac{A-2\\varepsilon}{B+2\\varepsilon}&\\leq d_{\\mathrm{rek}}\\leq\\frac{1}{h}\\log\\frac{A+2\\varepsilon}{B-2\\varepsilon},\\\\ 0\\leq\\varepsilon&<\\min\\left(\\frac{B}{2},\\frac{A-B}{4}\\right).\\end{aligned}",
