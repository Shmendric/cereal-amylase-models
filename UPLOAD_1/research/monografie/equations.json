  "add_info": "\\mathcal I=J^{\\mathsf T}\\Sigma^{-1}J,\\qquad \\mathcal I\\boldsymbol\\xi=0,\\qquad \\boldsymbol\\xi=(v_0,-a,\\eta,-\\kappa)^{\\mathsf T}",
