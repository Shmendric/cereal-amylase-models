  "add_grads": "\\begin{aligned}g_a&=\\left(-\\frac1\\ell,\\frac1\\ell,-\\frac{D}{\\ell^2}\\right)^{\\mathsf T},\\\\g_{v_0}&=\\left(\\frac{\\ell Z}{D^2},-\\frac{\\ell N}{D^2},\\frac ND\\right)^{\\mathsf T}.\\end{aligned}",
