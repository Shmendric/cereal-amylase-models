  "scalar_likelihood": "\\mathcal L(\\sigma^2)=\\frac12\\!\\left[n\\log(2\\pi\\sigma^2)+\\frac{\\mathrm{SSE}}{\\sigma^2}\\right],\\qquad \\widehat{\\sigma^2}=\\frac{\\mathrm{SSE}}n\\quad(\\mathrm{SSE}>0)",
