  "add_bound_v": "\\frac{(\\ell-\\delta_\\ell)(N-\\delta_N)}{D+\\delta_D}\\le v_{0,\\mathrm{true}}\\le\\frac{(\\ell+\\delta_\\ell)(N+\\delta_N)}{D-\\delta_D}",
  "add_systematic": "\\widehat v_0=\\frac{\\eta_0}{\\eta}\\,v_0,\\qquad\\widehat a=\\frac{\\eta}{\\eta_0}\\,a",
