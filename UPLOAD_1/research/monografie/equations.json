  "assay_Q_fit": "\\widehat Q_{-l}=\\exp\\left[\\frac{1}{16}\\sum_{i\\ne l}\\sum_{j=1}^{4}\\log\\left(\\frac{A_{37,ij}}{A_{20,ij}}\\right)\\right],\\qquad \\widehat A_{37,lj}=A_{20,lj}\\widehat Q_{-l}",
  "assay_log_error": "E_{\\log}=\\sqrt{\\frac{1}{20}\\sum_{l=1}^{5}\\sum_{j=1}^{4}\\left[\\log\\left(\\frac{\\widehat A_{37,lj}}{A_{37,lj}}\\right)\\right]^2}",
